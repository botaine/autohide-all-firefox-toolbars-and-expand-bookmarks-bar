/* ============================================ */
/* OVERLAY VERSION: the webpage never moves — tabs, nav-bar, and bookmarks */
/* all float ON TOP of the page when revealed, instead of pushing it down. */
/* This replaces the push-down mechanism entirely. #navigator-toolbox is  */
/* taken out of normal document flow via position:fixed, so none of the   */
/* margin-bottom logic from the push-down version is needed anymore —     */
/* the page simply always starts at the top of the window.                */
/*                                                                          */
/* File 2 (autohide_tabstoolbar_v2.css)'s original margin-bottom-based tab */
/* hiding mechanism has been REPLACED here with the same max-height +      */
/* visibility pattern used for nav-bar/bookmarks, so all three toolbars    */
/* behave consistently under one unified overlay system. If you use        */
/* Firefox's vertical tabs sidebar mode, that compatibility code from the   */
/* original File 2 was not carried over into this version — ask if you     */
/* need it added back.                                                     */
/* ============================================ */

#navigator-toolbox{
  --uc-bm-padding: 4px;
  --uc-autohide-toolbar-delay: 0350ms;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 9999 !important;
  overflow: visible !important;
  background-color: var(--toolbar-bgcolor, var(--lwt-accent-color, #1c1b22)) !important;
}
:root[uidensity="touch"] #navigator-toolbox{ --uc-bm-padding: 6px }

#sidebar-box,
#sidebar-main,
#sidebar-splitter,
#tabbrowser-tabbox{
  z-index: auto !important;
}

.tabbrowser-tab[selected]{ z-index: 3 !important; }

#navigator-toolbox > div{ display: contents }
:where(#navigator-toolbox > #TabsToolbar,#navigator-toolbox > #toolbar-menubar,#tab-notification-deck,.global-notificationbox,#notifications-toolbar){
  order: -1;
}

@media -moz-pref("browser.fullscreen.autohide"){
  :root[sizemode="fullscreen"] #navigator-toolbox[style*="margin-top"]{
    margin-top: calc(1px - var(--tab-min-height) - 2 * var(--tab-margin-block,var(--tab-block-margin,0px))) !important;
  }
}

/* Always-present trigger strip — catches the mouse at the very top of the
   window even when everything below it (tabs, nav-bar, bookmarks) is
   fully collapsed to zero height. */
#navigator-toolbox::before {
  content: "" !important;
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  height: 12px !important;
  z-index: 10001 !important;
  pointer-events: auto !important;
  background: transparent !important;
  -moz-window-dragging: drag !important;
}
#navigator-toolbox:hover::before,
#navigator-toolbox:focus-within::before,
#navigator-toolbox[externaldrag]::before {
  pointer-events: none !important;
}

/* Default hidden state for all three toolbars — real zero-height, not
   just visually hidden. Uses max-height instead of height:auto, since
   height:auto cannot be delayed/transitioned by Firefox. */
#TabsToolbar,
#nav-bar,
#PersonalToolbar{
  background-color: var(--toolbar-bgcolor, var(--lwt-accent-color, #1c1b22)) !important;
  background-image: none !important;
  overflow: hidden !important;
  max-height: 0 !important;
  min-height: 0 !important;
  visibility: hidden !important;
  transition: visibility 0ms linear var(--uc-autohide-toolbar-delay),
              max-height 0ms linear var(--uc-autohide-toolbar-delay),
              min-height 0ms linear var(--uc-autohide-toolbar-delay) !important;
}

/* Reveal triggers — shared across all three toolbars for consistent
   behavior: hovering the toolbox, focusing anything inside it (e.g. the
   urlbar), a menu panel being open, a cross-window tab drag
   ([externaldrag], set by cross-window-drag.uc.js), or dragging a tab
   within THIS window ([movingtab], set natively by Firefox). */
#navigator-toolbox:hover #TabsToolbar,
#navigator-toolbox:focus-within #TabsToolbar,
#navigator-toolbox[externaldrag] #TabsToolbar,
#navigator-toolbox[movingtab] #TabsToolbar,
#mainPopupSet:has(> [panelopen]:not(#ask-chat-shortcuts,#selection-shortcut-action-panel,#chat-shortcuts-options-panel,#tab-preview-panel)) ~ #navigator-toolbox #TabsToolbar,
:root[window-modal-open] #TabsToolbar,
#TabsToolbar[customizing]{
  max-height: 600px !important;
  min-height: var(--tab-min-height, 36px) !important;
  visibility: visible !important;
  overflow: visible !important;
  transition-delay: 0s !important;
}

#navigator-toolbox:hover #nav-bar,
#navigator-toolbox:focus-within #nav-bar,
#navigator-toolbox:has([breakout-extend]) #nav-bar,
#navigator-toolbox[externaldrag] #nav-bar,
#mainPopupSet:has(> [panelopen]:not(#ask-chat-shortcuts,#selection-shortcut-action-panel,#chat-shortcuts-options-panel,#tab-preview-panel)) ~ #navigator-toolbox #nav-bar,
:root[window-modal-open] #nav-bar,
#nav-bar[customizing]{
  max-height: 600px !important;
  min-height: 40px !important; /* --urlbar-height (32px) is only the address
    bar input's own height, not the full toolbar's real height including
    padding (measured at 40px with our CSS fully disabled) */
  visibility: visible !important;
  overflow: visible !important;
  transition-delay: 0s !important;
}

/* Reveal selectors explicitly exclude the collapsed state ([collapsed]) —
   Firefox's own "Never Show" setting for the bookmarks toolbar would
   otherwise be overridden during hover, forcing an empty, background
   -colored bar open. Uses a plain existence check rather than matching an
   exact value, since Firefox's actual attribute representation for this
   state doesn't match [collapsed=""] or [collapsed="true"] directly. */
#navigator-toolbox:hover #PersonalToolbar:not([collapsed]),
#navigator-toolbox:focus-within #PersonalToolbar:not([collapsed]),
#navigator-toolbox[externaldrag] #PersonalToolbar:not([collapsed]),
#mainPopupSet:has(> [panelopen]:not(#ask-chat-shortcuts,#selection-shortcut-action-panel,#chat-shortcuts-options-panel,#tab-preview-panel)) ~ #navigator-toolbox #PersonalToolbar:not([collapsed]),
:root[window-modal-open] #navigator-toolbox #PersonalToolbar:not([collapsed]),
#navigator-toolbox #PersonalToolbar[customizing]{
  max-height: 600px !important;
  visibility: visible !important;
  overflow: visible !important;
  transition-delay: 0s !important;
}

/* Defensive reset: make sure no intermediate wrapper inside the bookmarks
   bar caps its own height/overflow independently and clips the multi-row
   content before it reaches #PersonalToolbar's own box. */
#navigator-toolbox:hover #PersonalToolbar:not([collapsed]) #PlacesToolbar,
#navigator-toolbox:focus-within #PersonalToolbar:not([collapsed]) #PlacesToolbar,
#navigator-toolbox[externaldrag] #PersonalToolbar:not([collapsed]) #PlacesToolbar,
#navigator-toolbox:hover #PersonalToolbar:not([collapsed]) #PlacesToolbar > hbox,
#navigator-toolbox:focus-within #PersonalToolbar:not([collapsed]) #PlacesToolbar > hbox,
#navigator-toolbox[externaldrag] #PersonalToolbar:not([collapsed]) #PlacesToolbar > hbox{
  max-height: none !important;
  overflow: visible !important;
}

/* Preserve Firefox's own explicit "collapse bookmarks bar" state (set via
   right-click > Bookmarks Toolbar > Never Show) and fullscreen collapse —
   these should stay fully hidden regardless of hover. */
:root[sizemode="fullscreen"] #PersonalToolbar,
#PersonalToolbar:is([collapsed]){
  max-height: 0 !important;
  visibility: hidden !important;
}

/* Beats multi-row_bookmarks.css's own plain #PersonalToolbar{max-height:none}
   rule, which otherwise ties in specificity and wins by source order. */
#navigator-toolbox #PersonalToolbar{
  max-height: 0 !important;
}

#PersonalToolbar:is([collapsed]) #PlacesToolbarItems > *,
:root[sizemode="fullscreen"] #PersonalToolbar #PlacesToolbarItems > *{
  visibility: hidden !important;
}

#PlacesToolbarItems > .bookmark-item,
#OtherBookmarks,
#PersonalToolbar > #import-button{
  padding-block: var(--uc-bm-padding) !important;
}

/* Keeps tab row height consistent since TabsToolbar's own height is no
   longer constrained via the parent's margin the way File 2 originally did
   it. */
#tabbrowser-tabs:not([secondarytext-unsupported]) .tab-label-container{
  max-height: var(--tab-min-height);
}
.tab-label{ line-height: 20px !important; }
:root[uidensity="compact"] .tab-label{ line-height: 18px !important; }

/* FIX: Firefox sets --urlbar-container-height directly on the container
   element via inline style, and multiple of Firefox's own native rules
   (min-height, the dropdown's padding, and its vertical position) all
   calculate off this one variable. With custom toolbar height toggling,
   Firefox measures this incorrectly (observed as low as 8px), corrupting
   every downstream formula built on top of it. Overriding the variable
   itself, at its source, lets every native formula that reads it use the
   corrected value automatically. Targets the shared .urlbar-container
   class (matching Firefox's own native rule), since both the address bar
   (#urlbar-container) and the search bar (#search-container) carry this
   class and the same bug. */
.urlbar-container {
  --urlbar-container-height: 40px !important;
}

/* ============================================ */
/* multi-row_bookmarks.css (UNCHANGED)           */
/* Source: https://github.com/MrOtherGuy/firefox-csshacks/tree/master/chrome/multi-row_bookmarks.css */
/* Made available under Mozilla Public License v. 2.0 */
/* ============================================ */

#PersonalToolbar{
  --multirow-bmb-n-rows: 4;
  --multirow-bmb-row-margin: 2px;
  max-height: none !important;
}
:root[BookmarksToolbarOverlapsBrowser] :where(#PersonalToolbar){
  height: unset !important;
}

#PlacesToolbar > hbox:not(#PlacesToolbarDropIndicatorHolder){
  display: block;
  width: 100vw;
}

#PlacesToolbarItems{
  display: flex;
  flex-wrap: wrap;
  max-height: calc(var(--multirow-bmb-n-rows) * (4px + 1em + (2 * (var(--multirow-bmb-row-margin) + var(--uc-bm-padding,var(--bookmark-block-padding)))))) !important;
  overflow-y:auto;
  scrollbar-color: var(--lwt-accent-color,var(--toolbox-background-color,var(--toolbox-bgcolor))) var(--toolbar-background-color,var(--toolbar-bgcolor));
  scrollbar-gutter: stable;
  scrollbar-width: thin;
}

#PlacesChevron{ display: none }

#PlacesToolbarItems > .bookmark-item{
  margin: var(--multirow-bmb-row-margin) 0 !important;
  border-inline: 2px solid transparent;
  visibility: visible !important;
}
